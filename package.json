{
  "name": "hyalos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local, seeded WebGPU visual laboratory for distributed intelligence.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp run shaders:orb31 && vp run shaders:orbs && vp run typecheck && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test",
    "test:browser": "playwright test",
    "verify": "vp test && vp run build && vp run test:browser",
    "typecheck": "vp check --no-fmt --no-lint",
    "test:gpu": "playwright test --project=gpu --config playwright.gpu.config.ts",
    "shaders:orb31": "node scripts/compile-orb31.mjs",
    "serve": "node scripts/serve.mjs",
    "render:studies": "node scripts/render-studies.mjs",
    "shaders:orbs": "node scripts/compile-orbs.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "typegpu": "0.12.5",
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.18.0",
    "@webgpu/types": "0.1.69",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "unplugin-typegpu": "0.12.3",
    "vite-plus": "0.3.3"
  }
}
