{
  "name": "hyalos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local, seeded WebGPU visual laboratory for distributed intelligence.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run shaders:orb31 && npm run typecheck && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "verify": "npm test && npm run build && npm run test:browser",
    "publish:private": "bash scripts/publish-private.sh",
    "typecheck": "tsc --noEmit",
    "test:gpu": "playwright test --project=gpu --config playwright.gpu.config.ts",
    "shaders:orb31": "node scripts/compile-orb31.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "typegpu": "0.12.5",
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.18.0",
    "@webgpu/types": "0.1.69",
    "typescript": "5.9.3",
    "unplugin-typegpu": "0.12.3",
    "vite-plus": "0.3.3"
  }
}
